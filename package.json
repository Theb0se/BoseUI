{
  "name": "bose-ui",
  "version": "2.0.0",
  "private": false,
  "description": "BoseUI — Kinetic UI components that make modern web interfaces feel alive. Crafted by Rishabh Bose.",
  "author": {
    "name": "Rishabh Bose",
    "url": "https://theb0se.vercel.app/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Theb0se/bose-ui.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run sync && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "component:new": "tsx scripts/component-new.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "seo:generate": "tsx scripts/generate-seo.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "sync": "tsx scripts/generate-registry.ts && tsx scripts/generate-seo.ts && tsx scripts/validate-registry.ts && tsx scripts/seo-audit.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
